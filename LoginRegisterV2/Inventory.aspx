<%@ Page Language="C#" MasterPageFile="~/Site.master" AutoEventWireup="true" CodeBehind="Inventory.aspx.cs" Inherits="LoginRegisterV2.Inventory" %>

<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
    <div class="page-shell">
        <div class="dashboard-header">
            <div>
                <h2 class="mt-sm">📦 Inventory</h2>
                <p class="dashboard-user-line">Manage stock items, quantities, and reorder levels.</p>
            </div>
        </div>

        <asp:Label ID="lblMessage" runat="server" CssClass="alert alert-error" />
        <asp:Label ID="lblSuccess" runat="server" CssClass="alert alert-success" />

        <div class="card card--compact mb-sm">
            <h3 class="mt-0">Add New Item</h3>
            <div class="form-grid">
                <div class="form-group mb-0">
                    <label class="form-label">Item Name</label>
                    <asp:TextBox ID="txtItemName" runat="server" CssClass="form-control" />
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Category</label>
                    <asp:TextBox ID="txtCategory" runat="server" CssClass="form-control" />
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">SKU</label>
                    <asp:TextBox ID="txtSku" runat="server" CssClass="form-control" />
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Starting Quantity</label>
                    <asp:TextBox ID="txtQuantity" runat="server" CssClass="form-control" TextMode="Number" Text="0" />
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Reorder Level</label>
                    <asp:TextBox ID="txtReorderLevel" runat="server" CssClass="form-control" TextMode="Number" Text="10" />
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Unit Price (₱)</label>
                    <asp:TextBox ID="txtUnitPrice" runat="server" CssClass="form-control" TextMode="Number" Text="0" />
                </div>
            </div>
            <div class="btn-row">
                <asp:Button ID="btnAddItem" runat="server" Text="Add Item" CssClass="btn btn-primary" OnClick="btnAddItem_Click" />
            </div>
        </div>

        <div class="table-responsive">
            <asp:GridView ID="gvInventory" runat="server" CssClass="app-table" AutoGenerateColumns="false"
                GridLines="None" DataKeyNames="ItemId" AutoGenerateEditButton="true" AutoGenerateDeleteButton="true"
                OnRowEditing="gvInventory_RowEditing" OnRowCancelingEdit="gvInventory_RowCancelingEdit"
                OnRowUpdating="gvInventory_RowUpdating" OnRowDeleting="gvInventory_RowDeleting"
                EmptyDataText="No stock items yet. Add your first item above.">
                <Columns>
                    <asp:TemplateField HeaderText="Item">
                        <ItemTemplate><%# Eval("ItemName") %></ItemTemplate>
                        <EditItemTemplate><asp:TextBox ID="txtEditName" runat="server" CssClass="form-control" Text='<%# Bind("ItemName") %>' /></EditItemTemplate>
                    </asp:TemplateField>
                    <asp:TemplateField HeaderText="Category">
                        <ItemTemplate><%# Eval("Category") %></ItemTemplate>
                        <EditItemTemplate><asp:TextBox ID="txtEditCategory" runat="server" CssClass="form-control" Text='<%# Bind("Category") %>' /></EditItemTemplate>
                    </asp:TemplateField>
                    <asp:TemplateField HeaderText="SKU">
                        <ItemTemplate><%# Eval("SKU") %></ItemTemplate>
                        <EditItemTemplate><asp:TextBox ID="txtEditSku" runat="server" CssClass="form-control" Text='<%# Bind("SKU") %>' /></EditItemTemplate>
                    </asp:TemplateField>
                    <asp:TemplateField HeaderText="Qty">
                        <ItemTemplate>
                            <span class='<%# Convert.ToInt32(Eval("Quantity")) <= Convert.ToInt32(Eval("ReorderLevel")) ? "qty-low" : "" %>'><%# Eval("Quantity") %></span>
                        </ItemTemplate>
                        <EditItemTemplate>
                            <%# Eval("Quantity") %>
                            <span class="form-hint">Use Stock Transactions to change quantity.</span>
                        </EditItemTemplate>
                    </asp:TemplateField>
                    <asp:TemplateField HeaderText="Reorder Level">
                        <ItemTemplate><%# Eval("ReorderLevel") %></ItemTemplate>
                        <EditItemTemplate><asp:TextBox ID="txtEditReorder" runat="server" CssClass="form-control input-sm" Text='<%# Bind("ReorderLevel") %>' /></EditItemTemplate>
                    </asp:TemplateField>
                    <asp:TemplateField HeaderText="Unit Price">
                        <ItemTemplate>₱<%# Convert.ToDecimal(Eval("UnitPrice")).ToString("N2") %></ItemTemplate>
                        <EditItemTemplate><asp:TextBox ID="txtEditPrice" runat="server" CssClass="form-control input-sm" Text='<%# Bind("UnitPrice") %>' /></EditItemTemplate>
                    </asp:TemplateField>
                    <asp:BoundField DataField="UpdatedAt" HeaderText="Last Updated" DataFormatString="{0:MMM d, yyyy}" ReadOnly="true" />
                </Columns>
            </asp:GridView>
        </div>
    </div>
</asp:Content>
